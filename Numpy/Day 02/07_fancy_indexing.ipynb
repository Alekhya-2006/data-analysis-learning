   "source": [
    "# boolean indexing\n",
    "arr = np.array([1, 2, 3, 4, 5])\n",
    "\n",
    "print(arr[arr > 2])\n",
    "print(arr[arr % 2 == 0])\n",
    "print(arr[arr % 2 != 0])"
   ]
