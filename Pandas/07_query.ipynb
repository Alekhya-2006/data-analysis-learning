   "source": [
    "df = pd.read_csv(\"ipl_matches_2026.csv\")\n",
    "\n",
    "# Query\n",
    "df.query(\"team1_runs > 250 & toss_decision == 'bat'\") [[\"team1\", \"team2\", \"team1_runs\", \"player_of_match\"]]\n",
    "\n",
    "runs = 250\n",
    "df.query(\"team1_runs > @runs\")"
