   ],
   "source": [
    "# Series are Homogenous\n",
    "\n",
    "s1 = pd.Series([1, 2, 3, 4, 5])\n",
    "print(s1)  # dtype -> int64\n",
    "\n",
    "s2 = pd.Series([1, 2, 3.14, 4, 5])\n",
    "print(s2)  # dtype -> float64\n",
    "\n",
    "s3 = pd.Series([1, 2, 3, 4, \"Banthi\"])\n",
    "print(s3)  # dtype -> object"
   ]
  }
 ],
